# TDX API 憑證設定範例
# 請複製此檔案為 .env 並填入您的真實憑證

# TDX API 憑證 (請到 https://tdx.transportdata.tw/ 申請)
TDX_CLIENT_ID=your_client_id_here
TDX_CLIENT_SECRET=your_client_secret_here

# 電子郵件設定
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM_ADDRESS=your_email@gmail.com

# Google Maps API 設定 (請到 Google Cloud Console 申請)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 其他設定
TDX_BASE_URL=https://tdx.transportdata.tw/api/basic
TDX_TOKEN_URL=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token
